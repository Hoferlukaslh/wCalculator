<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ic="using:CalcApp"
             xmlns:loc="using:CalcApp.Localization"
             x:Class="CalcApp.Views.SettingsView">
  <UserControl.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource OverlayBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.swatch Border.dot">
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.swatch.sel Border.dot">
      <Setter Property="BorderBrush" Value="{DynamicResource Fg}"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16,8,16,24" Spacing="14" MaxWidth="560" HorizontalAlignment="Stretch">
      <TextBlock Classes="sub" Text="{loc:T Key=Appearance}" FontSize="14" Margin="2,0,0,0"/>

      <!-- Theme -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="ico" Text="{x:Static ic:Icons.CircleHalf}" FontSize="22" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:T Key=Theme}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <RadioButton GroupName="theme" IsChecked="{Binding IsThemeDevice, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="ico" Text="{x:Static ic:Icons.DeviceMobile}" FontSize="20" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:T Key=ThemeDevice}" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="theme" IsChecked="{Binding IsThemeDark, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="ico" Text="{x:Static ic:Icons.Moon}" FontSize="20" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:T Key=ThemeDark}" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="theme" IsChecked="{Binding IsThemeLight, Mode=TwoWay}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="ico" Text="{x:Static ic:Icons.Sun}" FontSize="20" VerticalAlignment="Center"/>
              <TextBlock Text="{loc:T Key=ThemeLight}" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>

      <!-- Accent colour -->
      <Border Classes="card">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="ico" Text="{x:Static ic:Icons.Palette}" FontSize="22" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:T Key=AccentColor}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Swatches}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="flat swatch" Classes.sel="{Binding IsSelected}"
                        Command="{Binding $parent[UserControl].DataContext.SelectAccentCommand}"
                        CommandParameter="{Binding}">
                  <Grid>
                    <Border Classes="dot" Width="34" Height="34" CornerRadius="17" Background="{Binding Brush}"/>
                    <TextBlock Classes="ico sub" Text="{x:Static ic:Icons.ArrowCounterClockwise}" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsDefault}"/>
                    <TextBlock Classes="ico" Text="{x:Static ic:Icons.Check}" FontSize="18" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowCheck}"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBox Text="{Binding CustomAccent, Mode=TwoWay}" Watermark="{loc:T Key=AccentCustom}" MaxLength="7"/>
        </StackPanel>
      </Border>

      <!-- Window transparency: only shown where the window system really gives a see-through window (not on mobile) -->
      <Border Classes="card" IsVisible="{Binding IsTransparencyEnabled}">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="ico" Text="{x:Static ic:Icons.DropHalf}" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="{loc:T Key=Transparency}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Classes="sub" Text="{Binding TransparencyText}" VerticalAlignment="Center"/>
          </Grid>
          <Slider Minimum="0" Maximum="100" TickFrequency="5" SmallChange="1" LargeChange="10"
                  Value="{Binding Transparency, Mode=TwoWay}" IsEnabled="{Binding IsTransparencyEnabled}"/>
          <TextBlock Classes="sub" Text="{Binding TransparencyNote}" TextWrapping="Wrap" FontSize="12"/>
          <TextBlock Text="{loc:T Key=WindowEffect}" Margin="0,8,0,0" IsEnabled="{Binding IsTransparencyEnabled}"/>
          <StackPanel IsEnabled="{Binding IsTransparencyEnabled}">
            <RadioButton GroupName="effect" Content="{loc:T Key=WindowEffectNone}" IsChecked="{Binding IsEffectNone, Mode=TwoWay}"/>
            <RadioButton GroupName="effect" Content="{loc:T Key=WindowEffectBlur}" IsChecked="{Binding IsEffectBlur, Mode=TwoWay}"/>
            <RadioButton GroupName="effect" Content="{loc:T Key=WindowEffectAcrylic}" IsChecked="{Binding IsEffectAcrylic, Mode=TwoWay}"/>
          </StackPanel>
          <TextBlock Classes="sub" Text="{loc:T Key=WindowEffectNote}" TextWrapping="Wrap" FontSize="12"/>
          <Border IsVisible="{Binding EffectNeedsRestart}" Background="{DynamicResource PanelBorder}" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Classes="ico" Text="{x:Static ic:Icons.Warning}" FontSize="20" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{loc:T Key=RestartNeeded}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- Navigation menu -->
      <Border Classes="card">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="ico" Text="{x:Static ic:Icons.List}" FontSize="22" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:T Key=MenuSection}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <TextBlock Text="{loc:T Key=MenuTransparency}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Classes="sub" Text="{Binding MenuTransparencyText}" VerticalAlignment="Center"/>
          </Grid>
          <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding MenuTransparency, Mode=TwoWay}"/>
          <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <TextBlock Text="{loc:T Key=MenuBlur}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Classes="sub" Text="{Binding MenuBlurText}" VerticalAlignment="Center"/>
          </Grid>
          <Slider Minimum="0" Maximum="30" SmallChange="1" LargeChange="5" Value="{Binding MenuBlur, Mode=TwoWay}"/>
        </StackPanel>
      </Border>

      <!-- Haptic feedback: only shown on devices that have a vibration motor (mobile) -->
      <Border Classes="card" IsVisible="{Binding IsHapticsAvailable}">
        <StackPanel Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="ico" Text="{x:Static ic:Icons.Vibrate}" FontSize="22" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:T Key=HapticsSection}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <CheckBox IsChecked="{Binding HapticsEnabled, Mode=TwoWay}" Content="{loc:T Key=HapticsEnabled}"/>
          <StackPanel Spacing="6" IsEnabled="{Binding HapticsEnabled}">
            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <TextBlock Text="{loc:T Key=HapticsDuration}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="sub" Text="{Binding HapticsDurationText}" VerticalAlignment="Center"/>
            </Grid>
            <Slider Minimum="5" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding HapticsDuration, Mode=TwoWay}"/>
            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <TextBlock Text="{loc:T Key=HapticsIntensity}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Classes="sub" Text="{Binding HapticsIntensityText}" VerticalAlignment="Center"/>
            </Grid>
            <Slider Minimum="5" Maximum="100" SmallChange="1" LargeChange="10" Value="{Binding HapticsIntensity, Mode=TwoWay}"/>
            <TextBlock Classes="sub" Text="{loc:T Key=HapticsNoAmplitude}" TextWrapping="Wrap" FontSize="12"
                       IsVisible="{Binding HapticsNoAmplitude}"/>
            <!-- Any button vibrates when pressed, so this one is the test. -->
            <Button Classes="flat" HorizontalAlignment="Left" Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="ico" Text="{x:Static ic:Icons.Vibrate}" FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:T Key=HapticsTest}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

      <Button Classes="flat" HorizontalAlignment="Left" Command="{Binding ResetCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="ico" Text="{x:Static ic:Icons.ArrowCounterClockwise}" FontSize="18" VerticalAlignment="Center"/>
          <TextBlock Text="{loc:T Key=ResetSettings}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>

      <StackPanel Spacing="2" Margin="2,10,0,0">
        <TextBlock Classes="sub" Text="{loc:T Key=IconsCredit}" FontSize="12"/>
        <TextBlock Classes="sub" Text="{loc:T Key=CurrencySource}" FontSize="12" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
